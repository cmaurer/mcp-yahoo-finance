{
  "name": "mcp-yahoo-finance",
  "version": "0.1.0",
  "description": "MCP server for Yahoo Finance data",
  "type": "module",
  "bin": { "mcp-yahoo-finance": "dist/index.js" },
  "files": ["dist"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
